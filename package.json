{
  "name": "@fabersep/spec",
  "version": "0.2.1",
  "private": false,
  "description": "Spec-driven engineering templates, documentation rules, and faber-* agent skills (Antigravity, Claude Code, Codex, Cursor) with a one-command interactive installer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabersep/spec.git"
  },
  "homepage": "https://github.com/fabersep/spec#readme",
  "bugs": {
    "url": "https://github.com/fabersep/spec/issues"
  },
  "keywords": [
    "fabersep",
    "spec-driven",
    "ai-agents",
    "skills",
    "prd",
    "bdd",
    "architecture",
    "claude-code",
    "antigravity",
    "codex",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "faber-spec": "src/cli.mjs"
  },
  "files": [
    "src",
    "plugin.json",
    ".claude-plugin",
    "rules",
    "templates",
    "skills",
    "!skills/**/__pycache__",
    "!**/*.pyc",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -v",
    "faber-spec": "node src/cli.mjs"
  }
}
